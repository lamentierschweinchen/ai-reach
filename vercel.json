{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/about", "destination": "/methodology" },
    { "source": "/mirror", "destination": "/api/mirror-og" }
  ],
  "redirects": [
    { "source": "/methodology", "destination": "/about", "statusCode": 301 },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "mirror.largelabormodel.com" }],
      "destination": "https://largelabormodel.com/mirror",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "mirror.largelabormodel.com" }],
      "destination": "https://largelabormodel.com/mirror",
      "statusCode": 301
    }
  ]
}
